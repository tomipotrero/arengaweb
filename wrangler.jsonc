{
  "name": "arengaweb",
  "compatibility_date": "2026-09-09",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "CONTACT_TO": "tomi@potrero.com.uy",
    "CONTACT_FROM": "web@arenga.uy"
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "tomi@potrero.com.uy" }
  ]
}
